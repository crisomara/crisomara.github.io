---
import { profile } from '../data/content';

const initials = profile.name
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<section id="top" class="relative overflow-hidden px-6 pt-20 pb-24 sm:pt-28">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[32rem] bg-[radial-gradient(ellipse_at_top,_rgba(45,212,191,0.15),_transparent_60%)]"
  >
  </div>

  <div class="mx-auto flex max-w-5xl flex-col items-center gap-8 text-center">
    <div
      class="flex h-24 w-24 items-center justify-center rounded-full bg-gradient-to-br from-teal-400 to-blue-600 text-2xl font-semibold text-white shadow-lg shadow-teal-500/20"
      aria-hidden="true"
    >
      {initials}
    </div>

    <div class="space-y-3">
      <h1 class="text-3xl font-semibold tracking-tight text-white sm:text-5xl">
        {profile.name}
      </h1>
      <p class="text-lg text-teal-300 sm:text-xl">{profile.title}</p>
      <p class="text-sm text-slate-400">{profile.location}</p>
    </div>

    <p class="max-w-2xl text-balance text-slate-300">
      Applied ML and data science — going deepest on early cardiac diagnosis and NCDs in
      low-resource settings, and carrying the same toolkit into problems well outside
      healthcare.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="#projects"
        class="rounded-full bg-teal-400 px-6 py-2.5 text-sm font-medium text-slate-950 transition-transform hover:scale-105"
      >
        View Projects
      </a>
      <a
        href="#contact"
        class="rounded-full border border-white/15 px-6 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:border-teal-400/50 hover:text-teal-300"
      >
        Contact Me
      </a>
    </div>
  </div>
</section>
