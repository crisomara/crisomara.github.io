---
import { techStack } from '../data/content';
---

<section class="border-t border-white/5 px-6 py-20">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-teal-400">Tech Stack</h2>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {techStack.map((group) => (
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">
            {group.category}
          </h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="rounded-full border border-white/10 px-3 py-1 text-sm text-slate-300">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
